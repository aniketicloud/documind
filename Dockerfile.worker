# Documind ingest worker — runs inside Compose (no separate terminal required).
FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# Native deps for some npm packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# tsx runs TypeScript worker directly
CMD ["npx", "tsx", "scripts/ingest-worker.ts"]
