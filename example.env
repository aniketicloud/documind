POSTGRES_USER=documind
POSTGRES_PASSWORD=password
POSTGRES_DB=documind

DATABASE_URL=postgresql://documind:password@localhost:5433/documind

# Redis (docker compose service `redis`) — demo API + ingest job queue
REDIS_URL=redis://127.0.0.1:6379

# Ingest worker runs in Docker: service `ingest-worker` (docker compose up -d)
# Do not also start a host worker unless debugging.
# INGEST_WORKER_ID=worker-1
# INGEST_POLL_MS=1500

# PDF extract (Docker: pdf-extract → host 8090)
# Host URL for rare local tools; compose worker uses http://pdf-extract:8090
PDF_EXTRACT_URL=http://127.0.0.1:8090
# off | auto | force — auto = native first, OCR if scanned (F1b)
PDF_OCR_MODE=auto
# OCR can take minutes on multi-page scans
PDF_EXTRACT_TIMEOUT_MS=300000
# PDF_OCR_MAX_PAGES=30
# PDF_OCR_LANG=eng

BETTER_AUTH_SECRET=generate-with openssl rand -base64 32 or use a password manager to generate a random string of 32 characters
BETTER_AUTH_URL=http://localhost:3000

# RustFS (S3-compatible) — docker compose service `rustfs`
# API: http://localhost:9000  |  Console: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=documind
S3_REGION=us-east-1
# Browser origin allowed for CORS (usually same as BETTER_AUTH_URL)
S3_CORS_ORIGIN=http://localhost:3000

# Gemini — @google/genai Interactions API + gemini-embedding-2 (no legacy generateContent)
# Never commit real keys. Paste into .env only.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Matryoshka dim for Qdrant (768 | 1536 | 3072). Changing requires re-ingest.
GEMINI_EMBED_DIMENSIONS=768

# Z.AI / GLM — OpenAI-compatible chat (https://api.z.ai/api/paas/v4)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Default chat model when client does not send modelId:
# glm-4.7-flash | gemini-3.1-flash-lite
DEFAULT_CHAT_MODEL=glm-4.7-flash

# Qdrant (docker compose service `qdrant`) — host 6335 → container 6333
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=documind_chunks

# Optional ingest limits
# INGEST_MAX_CHARS=500000
